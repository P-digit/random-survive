# 이 파일을 .env 로 복사한 뒤, 아래 값을 지우고 본인의 API 키를 넣으세요.
# 실제 키는 .env 에만 넣습니다. .env 는 깃에 올라가지 않지만, 이 파일(.env.example)은 올라갑니다.
# OpenAI 키와 Gemini 키 중 하나만 있어도 됩니다. 둘 다 있으면 OpenAI를 씁니다(LLM_PROVIDER로 바꿀 수 있음).
OPENAI_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-key-here

# 선택: 공급자 고르기 (openai / gemini)
# LLM_PROVIDER=gemini

# 선택: 모델 변경 (지정하지 않으면 공급자별 기본값)
# LLM_MODEL=gpt-4o-mini              # Gemini 기본값: gemini-3.5-flash
# IMAGE_MODEL=gpt-image-1-mini       # 장면 그림은 지금은 OpenAI에서만 그립니다
# EMBEDDING_MODEL=text-embedding-3-small   # Gemini 기본값: gemini-embedding-001
# GEMINI_REASONING_EFFORT=low        # none / low / medium / high
